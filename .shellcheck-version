# The shellcheck gate, declared once and read by both sides: the `shellcheck`
# step in .github/workflows/ci.yml and the shellcheck section of
# tests/run_tests.sh. Neither side may take the version or the severity
# threshold from whatever the environment happens to provide.
#
# The version is not a detail, it is the gate. SC2015 fires on 0.9.0 and is
# silent on 0.11.0 for the same source, so a floating tool lets the two sides
# reach opposite verdicts on an identical tree -- which is exactly how run
# 31282575227 failed in CI on a file the local gate had just called clean.
# 0.9.0 is pinned because it is the verdict already in force in CI; moving to a
# newer shellcheck changes what the gate accepts and is a separate decision,
# not a side effect of a repair.
#
# Bump the version and the digest together. Never one alone.
SHELLCHECK_VERSION=0.9.0
SHELLCHECK_SEVERITY=style
SHELLCHECK_SHA256_LINUX_X86_64=700324c6dd0ebea0117591c6cc9d7350d9c7c5c287acbad7630fa17b1d4d9e2f
